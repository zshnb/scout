{
  "name": "scout-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "play": "tsx src/client/main.tsx",
    "build": "bun scripts/build-client.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:rooms": "tsx tests/rooms.ts"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "ink-testing-library": "^4.0.0",
    "string-width": "^7.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.161.0"
  }
}
